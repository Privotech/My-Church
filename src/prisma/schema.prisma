generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sermon {
  id          String   @id @default(cuid())
  title       String
  speaker     String
  date        DateTime
  description String
  videoUrl    String?
  audioUrl    String?
  series      String?
  isPublished Boolean  @default(true)
  publishAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date(sort: Desc)])
  @@index([speaker])
}

model Event {
  id             String   @id @default(cuid())
  title          String
  dayOrFrequency String
  time           String
  description    String?
  category       String
  order          Int      @default(0)
  status         String   @default("UPCOMING")
  eventDate      DateTime?
  isFeatured     Boolean  @default(false)
  isPublished    Boolean  @default(true)
  publishAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category, order])
}

model TeamMember {
  id                 String   @id @default(cuid())
  name               String
  role               String
  quoteOrDescription String
  imageUrl           String?
  order              Int      @default(0)
  isPublished        Boolean  @default(true)
  publishAt          DateTime?
  deletedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([order])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model PrayerRequest {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  request   String
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model Testimonial {
  id             String   @id @default(cuid())
  name           String
  locationOrRole String?
  category       String
  title          String
  story          String
  scripture      String?
  isApproved     Boolean  @default(true)
  publishAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([category])
}

model ChurchUpdate {
  id          String   @id @default(cuid())
  title       String
  summary     String
  content     String
  imageUrl    String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  publishAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([isPublished, publishedAt(sort: Desc)])
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  imageUrl    String
  date        DateTime @default(now())
  location    String
  featured    Boolean  @default(false)
  isPublished Boolean  @default(true)
  publishAt   DateTime?
  sortOrder   Int      @default(0)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([date(sort: Desc)])
  @@index([category])
  @@index([sortOrder])
}

model AdminActivity {
  id        String   @id @default(cuid())
  section   String
  action    String
  title     String
  entryId   String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}
