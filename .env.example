# Copy this file to .env.local for local development.
#
# Never commit .env.local or place real credentials in this example file.

# Required by Prisma and the server-side data service.
# Use the pooled Neon connection string for application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# Optional. Used for canonical metadata URLs in app/layout.tsx.
APP_URL="http://localhost:3000"

# Optional. Only needed for authenticated Neon CLI commands.
# Do not expose this value to the browser.
NEON_API_KEY=""

# Secret key used to sign the private admin session.
ADMIN_SECRET_KEY="replace_with_a_long_private_secret"
